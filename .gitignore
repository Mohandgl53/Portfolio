# ==========================================
# Mohan Kumar T — Portfolio (.gitignore)
# ==========================================

# Dependencies (Never commit heavy packages)
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles (Generated by 'npm run build')
dist/
dist-ssr/
build/
out/
*.local

# Internal Development Archive & Diagnostic Scripts
archive/
_archive/
_archive_tools/

# Temporary Test Profiles & Scrapers
temp_browser_profile/
temp_browser_profile*/
temp_browser_p*/
temp-profile*/
*.tmp
*.temp

# Python / Diagnostic Cache (from earlier test harnesses)
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Test Screenshots & Dumps in Root (preserve images inside src/)
/*.png
/*.jpg
/*.jpeg
/*.webp
test_*.html
test_*.png
test_*.js
*.log

# Vite & Bundler Cache
.vite/
.vite-temp/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
